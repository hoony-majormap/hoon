{% extends "base.html.j2" %}
{# 02 큰 숫자 — 오프화이트 배경, 초대형 숫자 1개 + 막대 #}
{% block style %}
<style>
.label {
  margin-top: 64px;
  font-size: calc(46px * var(--fs));
  font-weight: 800;
  line-height: 1.3;
}
.big {
  margin-top: 28px;
  font-size: calc(290px * var(--fs));
  font-weight: 900;
  line-height: 1;
  letter-spacing: -10px;
  color: var(--red);
  white-space: nowrap;
  overflow: hidden;
}
.big small { font-size: .5em; letter-spacing: -2px; margin-left: 6px; }
.line {
  margin-top: 26px;
  font-size: calc(56px * var(--fs));
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: -1.5px;
}
.bar { margin-top: 56px; }
.bar-track {
  display: flex;
  height: 76px;
  border-radius: 38px;
  overflow: hidden;
  background: var(--line);
}
.bar-left { background: var(--red); }
.bar-right { background: #C6CEDB; }
.bar-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 16px;
  font-size: calc(30px * var(--fs));
  font-weight: 700;
}
.bar-legend .l { color: var(--red); }
.bar-legend .r { color: var(--ink-2); }
.content .dialogue { margin-top: auto; }
</style>
{% endblock %}
{% block deco %}
<div class="skew" style="left:-200px; bottom:-80px; width:380px; height:520px; background:var(--gray-bg);"></div>
{% endblock %}
{% block content %}
<p class="label" data-fit data-max-lines="2">{{ slide.label }}</p>
<div class="big" data-fit data-autofit>{{ slide.number_main }}{% if slide.number_unit %}<small>{{ slide.number_unit }}</small>{% endif %}</div>
<p class="line" data-fit data-max-lines="2">{{ slide.line }}</p>
{% if slide.bar_left %}
<div class="bar">
  <div class="bar-track">
    <div class="bar-left" style="width: {{ slide.bar_left_pct }}%"></div>
    <div class="bar-right" style="width: {{ 100 - slide.bar_left_pct }}%"></div>
  </div>
  <div class="bar-legend">
    <span class="l" data-fit>{{ slide.bar_left_label }} {{ slide.bar_left }}</span>
    <span class="r" data-fit>{{ slide.bar_right_label }} {{ slide.bar_right }}</span>
  </div>
</div>
{% endif %}
{{ dialogue(slide.dialogue) }}
{% endblock %}
