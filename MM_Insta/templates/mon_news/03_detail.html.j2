{% extends "base.html.j2" %}
{# 03 디테일 — 민트 배경, 흰 패널 2개(수치 변화 + 도트 그래프) #}
{% block style %}
<style>
.title { margin-top: 56px; }
.panels { display: flex; flex-direction: column; gap: 28px; margin-top: 40px; }
.panel {
  padding: 36px 44px 38px;
  border-radius: 32px;
  background: var(--white);
  color: var(--navy);
}
.panel h3 {
  font-size: calc(32px * var(--fs));
  font-weight: 700;
  color: var(--ink-2);
}
.change {
  display: flex;
  align-items: baseline;
  gap: 22px;
  margin-top: 14px;
  white-space: nowrap;
}
.change .from {
  font-size: calc(64px * var(--fs));
  font-weight: 700;
  color: #9AA3B5;
  text-decoration: line-through;
  text-decoration-thickness: 4px;
}
.change .arrow { font-size: calc(56px * var(--fs)); font-weight: 900; color: var(--red); }
.change .to {
  font-size: calc(92px * var(--fs));
  font-weight: 900;
  letter-spacing: -2px;
  color: var(--navy);
}
.note {
  margin-top: 12px;
  font-size: calc(32px * var(--fs));
  font-weight: 700;
  line-height: 1.4;
}
.note em { font-style: normal; color: var(--red); }
.dots-row { display: flex; align-items: center; gap: 36px; margin-top: 18px; }
.dots {
  display: grid;
  grid-template-columns: repeat({{ slide.dots_cols }}, 38px);
  gap: 12px;
  flex: none;
}
.dot { width: 38px; height: 38px; border-radius: 50%; background: var(--line); }
.dot.on { background: var(--red); }
.dots-num {
  font-size: calc(80px * var(--fs));
  font-weight: 900;
  letter-spacing: -2px;
  white-space: nowrap;
}
.dots-num small { font-size: .45em; color: var(--ink-2); letter-spacing: 0; }
.content .dialogue { margin-top: auto; }
</style>
{% endblock %}
{% block deco %}
<div class="skew" style="right:-160px; top:-40px; width:360px; height:600px; background:#A3D1C1;"></div>
{% endblock %}
{% block content %}
<h2 class="title" data-fit data-max-lines="2">{{ slide.title }}</h2>
<div class="panels">
  <div class="panel">
    <h3 data-fit>{{ slide.change.title }}</h3>
    <div class="change" data-fit>
      <span class="from">{{ slide.change.before }}</span>
      <span class="arrow">→</span>
      <span class="to">{{ slide.change.after }}</span>
    </div>
    <p class="note" data-fit data-max-lines="2">{{ slide.change.note }}</p>
  </div>
  <div class="panel">
    <h3 data-fit>{{ slide.dots.title }}</h3>
    {% if slide.dots_total %}
    <div class="dots-row">
      <div class="dots">
        {%- for i in range(slide.dots_total) %}<i class="dot{{ ' on' if i < slide.dots_filled }}"></i>{% endfor -%}
      </div>
      <div class="dots-num" data-fit>{{ slide.dots.filled }}<small> / {{ slide.dots.total }}</small></div>
    </div>
    {% endif %}
    <p class="note" data-fit data-max-lines="2">{{ slide.dots.note }}</p>
  </div>
</div>
{{ dialogue(slide.dialogue) }}
{% endblock %}
