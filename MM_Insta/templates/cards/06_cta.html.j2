{% extends "base.html.j2" %}
{# 06 저장·CTA — 네이비 배경, 저장 유도 + majormap.net + 다음 회 예고 + 전체 출처 #}
{% block style %}
<style>
.save { display: flex; align-items: center; gap: 36px; margin-top: 120px; }
.save svg { flex: none; width: 120px; height: 150px; }
.save h2 { font-size: calc(92px * var(--fs)); font-weight: 900; line-height: 1.18; letter-spacing: -2px; }
.site {
  align-self: flex-start;
  margin-top: 64px;
  padding: 26px 52px;
  background: var(--red);
  font-size: calc(46px * var(--fs));
  font-weight: 900;
  letter-spacing: .5px;
  transform: skewX(-18deg);
}
.site span { display: inline-block; transform: skewX(18deg); }
.next {
  margin-top: 72px;
  padding: 28px 36px;
  border-radius: 24px;
  border: 3px solid var(--mint);
}
.next b { display: block; font-size: calc(26px * var(--fs)); font-weight: 800; letter-spacing: 1px; color: var(--mint); }
.next p { margin-top: 10px; font-size: calc(44px * var(--fs)); font-weight: 800; line-height: 1.3; }
.content .dialogue { margin-top: 56px; }
.sources {
  margin-top: auto;
  padding-top: 24px;
  border-top: 2px solid #3A4663;
  font-size: calc(22px * var(--fs));
  font-weight: 500;
  line-height: 1.55;
  color: #AEB6C7;
}
.sources b { color: var(--white); font-weight: 700; }
</style>
{% endblock %}
{% block deco %}
<div class="skew" style="right:-120px; top:-40px; width:380px; height:700px; background:#26324F;"></div>
{% endblock %}
{% block content %}
<div class="save">
  <svg viewBox="0 0 120 150" aria-hidden="true"><path d="M10 8 h100 v134 l-50 -36 l-50 36 z" fill="#EA5645"/><path d="M38 60 l16 16 l30 -32" stroke="#fff" stroke-width="12" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <h2 data-fit data-max-lines="2">{{ slide.headline }}</h2>
</div>
<div class="site"><span>{{ site }}</span></div>
<div class="next">
  <b>NEXT · {{ next_label }}</b>
  <p data-fit data-max-lines="2">{{ slide.teaser }}</p>
</div>
{{ dialogue(slide.dialogue) }}
<div class="sources" data-fit>
  <b>출처</b> {{ all_sources }}<br>{{ source_note }}
</div>
{% endblock %}
