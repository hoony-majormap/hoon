# Supabase (majormap-studio) — 읽기 전용 publishable 키. 서버에서만 쓰고 브라우저로 보내지 않는다
SUPABASE_URL=https://recajgmjuhintkpazkfi.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# (선택) 페이지 비밀번호 — 설정하면 접속 시 아이디/비밀번호 창이 뜬다 (아이디는 아무거나)
